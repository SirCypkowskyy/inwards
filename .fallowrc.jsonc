{
  "$schema": "./node_modules/fallow/schema.json",
  // Run by CI (`bun run src/core/scripts/prescan-diff.ts`), not from package.json.
  // eval/run.ts is the agent eval, run by hand with `bun run eval/run.ts`.
  // The placeholder bin.js is the `bin` of the npm name placeholder, run by `node`.
  // bench/compare.ts is run by .github/workflows/bench.yml, bench/corpus.ts by corpus.yml,
  // and scripts/claude-payload-drift.ts by .github/workflows/nightly-e2e.yml.
  "entry": [
    "src/core/scripts/prescan-diff.ts",
    "eval/run.ts",
    "bench/compare.ts",
    "bench/corpus.ts",
    "scripts/claude-payload-drift.ts",
    "packaging/placeholder/npm/bin.js"
  ],
  // Loaded by path, never imported: Bun.resolveSync("tree-sitter-python/...wasm")
  // in core's tests and scripts, and the extension's scripts/copy-wasm.ts.
  // eslint-plugin-jsdoc is loaded by oxlint through .oxlintrc.jsonc "jsPlugins".
  "ignoreDependencies": ["tree-sitter-python", "eslint-plugin-jsdoc"],
  // Fail CI when more than 3% of the code is duplicated (it is 0% today).
  "duplicates": { "threshold": 3 },
  // checkFiles and index: called by the CLI on the Engine that Engine.create()
  // returns; fallow does not follow the type of an awaited factory result.
  // importersOf: only tests call it until the Stop gate (#20) lands; drop it
  // from this list in that PR.
  "usedClassMembers": ["checkFiles", "index", "importersOf"],
  "boundaries": {
    // A file belongs to the first zone that matches, so index.ts comes before
    // the rest of the engine.
    "zones": [
      { "name": "core-api", "patterns": ["src/core/src/index.ts"] },
      { "name": "core", "patterns": ["src/core/src/**"] },
      { "name": "core-dev", "patterns": ["src/core/test/**", "src/core/scripts/**"] },
      { "name": "cli", "patterns": ["src/cli/**"] },
      { "name": "vscode", "patterns": ["src/vscode-extension/**"] },
      { "name": "scripts", "patterns": ["scripts/**"] },
      { "name": "eval", "patterns": ["eval/**"] },
      { "name": "bench", "patterns": ["bench/**"] },
      { "name": "packaging", "patterns": ["packaging/**"] }
    ],
    "rules": [
      // The engine imports nothing of ours; adapters come to it.
      { "from": "core", "allow": [] },
      { "from": "core-api", "allow": ["core"] },
      // Its own tests and the prescan differential test may reach internals.
      { "from": "core-dev", "allow": ["core-api", "core"] },
      // Adapters use the engine through `@inwards/core` (index.ts) only.
      { "from": "cli", "allow": ["core-api"] },
      { "from": "vscode", "allow": ["core-api"] },
      { "from": "scripts", "allow": [] },
      // The eval harness reads layers the way the CLI does, through the public API.
      { "from": "eval", "allow": ["core-api"] },
      // The bench runs binaries as processes and imports nothing of ours.
      { "from": "bench", "allow": [] },
      // The npm placeholder ships alone and imports nothing.
      { "from": "packaging", "allow": [] }
    ],
    // No I/O or runtime specifics in the engine: those come through a port.
    "calls": {
      "forbidden": [
        {
          "from": "core",
          "callee": ["Bun.*", "Deno.*", "process.*", "console.*", "fs.*", "child_process.*"]
        }
      ]
    },
    // A new directory must be given a zone before it can hide from these rules.
    "coverage": { "requireAllFiles": true }
  }
}
