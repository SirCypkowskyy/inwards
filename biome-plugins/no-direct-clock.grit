// Policy code reads the time through the Clock contract, so a test can fix it
// and a run's timestamps come from one place (#176). Date.parse and
// new Date(value) are pure and stay allowed. Scoped by the overrides in
// biome.jsonc that list this file.
language js

or {
  `Date.now()`,
  `new Date()`,
  `Date()`,
  `performance.now()`,
  `globalThis.Date.now()`,
  `new globalThis.Date()`,
  `globalThis.performance.now()`
} as $read where {
  register_diagnostic(span=$read, message="Read the time through the Clock contract (platform/contracts.ts), not the system clock.")
}
