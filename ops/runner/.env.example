# Copy to /opt/inwards-runner/.env (chmod 600). Never commit the real file.
#
# Fine-grained personal access token: repository access "Only select
# repositories" -> SirCypkowskyy/inwards, permission Administration: Read and
# write (needed to create just-in-time runners). Nothing else.
GITHUB_PAT=

# Optional overrides (defaults shown).
# RUNNER_REPO=SirCypkowskyy/inwards
# RUNNER_IMAGE=inwards-runner:latest
# RUNNER_NAME_PREFIX=irysek
# RUNNER_NETWORK=inwards-ci
# RUNNER_MEMORY=2g            # also the swap limit: no swap
# RUNNER_CPUS=2
