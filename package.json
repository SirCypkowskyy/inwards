{
  "name": "inwards-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/core",
    "src/cli",
    "src/vscode-extension"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "build:cli": "bun run scripts/build-binaries.ts",
    "check:self": "bun run src/cli/src/main.ts check examples/clean-app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
