{
  "name": "inwards-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/core",
    "src/cli",
    "src/vscode-extension"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p . && bun run --filter '*' typecheck",
    "test": "bun test",
    "lint:docs": "oxlint --config .oxlintrc.jsonc --deny-warnings",
    "fallow": "fallow dead-code && fallow dupes && bun run scripts/check-no-clones.ts",
    "check:cycles": "bun run scripts/check-import-cycles.ts",
    "check:overviews": "bun run scripts/check-module-overviews.ts src scripts eval bench docs/test",
    "build:cli": "bun run scripts/build-binaries.ts",
    "check:self": "bun run src/cli/src/main.ts check examples/clean-app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "eslint-plugin-jsdoc": "65.4.5",
    "fallow": "3.42.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
