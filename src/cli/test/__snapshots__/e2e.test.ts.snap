"{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"inwards","informationUri":"https://sircypkowskyy.github.io/inwards","version":"<version>","rules":[{"id":"INW001","name":"layer-dependency","shortDescription":{"text":"Dependencies must point toward inner layers."},"helpUri":"https://sircypkowskyy.github.io/inwards/03-Architecture-C4/#rule-catalogue"}]}},"results":[{"ruleId":"INW001","level":"error","message":{"text":"Layer \\"domain\\" imports \\"shop.infrastructure.db\\" from outer layer \\"infrastructure\\". Allowed direction: domain <- infrastructure.\\nFix: Depend on an abstraction owned by \\"domain\\" instead of \\"shop.infrastructure.db\\".\\n1. Delete \`import shop.infrastructure.db\`. Do not move the import into a function or behind TYPE_CHECKING; Inwards checks those too.\\n2. Declare a typing.Protocol in \`shop.domain\` (for example \`shop.domain.ports\`) that describes only what this module needs from \`db\`.\\n3. Type this module against that Protocol and receive the implementation through a constructor or function parameter.\\n4. Make the class in \\"infrastructure\\" satisfy the Protocol, and wire it in the outermost layer (the composition root)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"shop/domain/order.py"},"region":{"startLine":1,"startColumn":8,"endLine":1,"endColumn":30}}}],"properties":{"fix":{"summary":"Depend on an abstraction owned by \\"domain\\" instead of \\"shop.infrastructure.db\\".","steps":["Delete \`import shop.infrastructure.db\`. Do not move the import into a function or behind TYPE_CHECKING; Inwards checks those too.","Declare a typing.Protocol in \`shop.domain\` (for example \`shop.domain.ports\`) that describes only what this module needs from \`db\`.","Type this module against that Protocol and receive the implementation through a constructor or function parameter.","Make the class in \\"infrastructure\\" satisfy the Protocol, and wire it in the outermost layer (the composition root)."]}}}]}]}
"
