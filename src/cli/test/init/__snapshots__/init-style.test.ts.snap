exports[`inwards init --style X --scaffold on a fresh uv project layered: exit 0, then check reports 0 violations and 0 warnings 1`] = `
{
  "check": {
    "filesChecked": 11,
    "violations": 0,
    "warnings": 0,
  },
  "created": [
    "src/my_app/bootstrap.py",
    "src/my_app/domain/__init__.py",
    "src/my_app/domain/order.py",
    "src/my_app/persistence/__init__.py",
    "src/my_app/persistence/in_memory_orders.py",
    "src/my_app/persistence/orders.py",
    "src/my_app/presentation/__init__.py",
    "src/my_app/presentation/cli.py",
    "src/my_app/services/__init__.py",
    "src/my_app/services/place_order.py",
    "tests/test_place_order.py",
  ],
  "stdout": 
"inwards init: wrote the layered preset to pyproject.toml and 11 example files.

src/my_app/  (layered)
├── bootstrap.py   bootstrap: may import every other layer
├── domain/        domain: imports no other layer
├── persistence/   persistence: may import domain
├── presentation/  presentation: may import domain, persistence, services
└── services/      services: may import domain, persistence

inwards check: 0 violations, 0 warnings.

Try the example: uv run python -m my_app.bootstrap book 2
Wire an agent: inwards init --agent claude|opencode|aider|agents-md
"
,
  "table": 
"[tool.inwards]
# Preset "layered" (inwards init --style layered, Inwards <VERSION>).
# Layers are listed innermost first: each may import itself and the layers above it.
# Not enforced by this preset: presentation may call persistence without going through services (open layers).
root = "src"
required-version = "<VERSION>"
ignore = ["tests", "scripts", "migrations", "conftest"]
layers = [
  { name = "domain", modules = ["my_app.domain"] },              # entities shared by every layer
  { name = "persistence", modules = ["my_app.persistence"] },    # repositories and their Protocols
  { name = "services", modules = ["my_app.services"] },          # business operations (use cases)
  { name = "presentation", modules = ["my_app.presentation"] },  # CLI or HTTP handlers
  { name = "bootstrap", modules = ["my_app.bootstrap"] },        # composition root: wires the adapters into the use cases
]

# Package shapes (INW007, INW008) for the scaffold's packages.
# my_app: the layers and the composition root only; anything else is an error, since no layer would hold it.
[[tool.inwards.shape]]
packages = ["my_app"]
require = ["domain/", "persistence/", "services/", "presentation/", "bootstrap.py"]
allow = ["__main__.py", "_version.py"]
"
,
}
`;

