"{"$schema":"https://json.schemastore.org/sarif-2.1.0.json","version":"2.1.0","runs":[{"tool":{"driver":{"name":"inwards","informationUri":"https://sircypkowskyy.github.io/inwards","version":"<version>","rules":[{"id":"INW000","name":"unsupported-encoding","shortDescription":{"text":"The file's declared encoding can hide imports."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW000/","defaultConfiguration":{"level":"error"}},{"id":"INW001","name":"layer-dependency","shortDescription":{"text":"Dependencies must point toward inner layers."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW001/","defaultConfiguration":{"level":"error"}},{"id":"INW002","name":"context-independence","shortDescription":{"text":"A bounded context imports another context only when it declares it in depends-on."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW002/","defaultConfiguration":{"level":"error"}},{"id":"INW003","name":"public-api-only","shortDescription":{"text":"Code outside a bounded context imports only the context's public modules."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW003/","defaultConfiguration":{"level":"error"}},{"id":"INW004","name":"import-cycles","shortDescription":{"text":"Modules, or bounded contexts, don't import each other in a cycle."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW004/","defaultConfiguration":{"level":"error"}},{"id":"INW005","name":"pure-domain","shortDescription":{"text":"A layer imports only the third-party and standard-library modules its config allows."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW005/","defaultConfiguration":{"level":"error"}},{"id":"INW006","name":"unassigned-module","shortDescription":{"text":"First-party code must belong to a layer, and every layer prefix must match modules."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW006/","defaultConfiguration":{"level":"error"}},{"id":"INW007","name":"package-shape","shortDescription":{"text":"A package holds only the members its configured shape allows, and names stay where they belong."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW007/","defaultConfiguration":{"level":"error"}},{"id":"INW008","name":"missing-member","shortDescription":{"text":"A package holds every member its configured shape requires."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW008/","defaultConfiguration":{"level":"error"}},{"id":"INW009","name":"suppression-comment","shortDescription":{"text":"An inline suppression names rules that can be suppressed, gives a reason, and hides a finding."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW009/","defaultConfiguration":{"level":"error"}},{"id":"INW010","name":"unknown-first-party","shortDescription":{"text":"An imported first-party module must exist."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW010/","defaultConfiguration":{"level":"error"}},{"id":"INW011","name":"dynamic-import","shortDescription":{"text":"Dynamic imports (importlib, __import__, runpy, exec) must point toward inner layers too."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW011/","defaultConfiguration":{"level":"error"}},{"id":"INW012","name":"thin-endpoint","shortDescription":{"text":"An HTTP endpoint reads the request, calls one use case and shapes the response; the logic, queries and outgoing calls live in other layers."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW012/","defaultConfiguration":{"level":"warning","enabled":false}},{"id":"INW013","name":"async-blocking","shortDescription":{"text":"An async def makes no synchronous database, cache or cloud call: a sync SQLAlchemy Session, redis.Redis, boto3 or a blocking driver stalls the event loop."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW013/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"INW014","name":"ports-abstract","shortDescription":{"text":"A port module holds only ABCs and Protocols whose methods have no body; implementations live in adapters."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW014/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"INW015","name":"construct-only-in","shortDescription":{"text":"Only the composition root imports and builds the modules of a guarded role, such as the outbound adapters; everything else takes them through a port."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW015/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"INW016","name":"orm-naming","shortDescription":{"text":"ORM table names and the names of datetime and date columns follow the project's scheme: lower_case_snake singular tables, _at for datetimes, _date for dates."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW016/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"INW017","name":"diagram-unknown-name","shortDescription":{"text":"A node in a marked architecture diagram names a layer or context [tool.inwards] declares, and its quoted label a module that exists."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/INW017/","defaultConfiguration":{"level":"warning","enabled":false}},{"id":"FAPI001","name":"endpoint-metadata","shortDescription":{"text":"A FastAPI path operation declares the OpenAPI metadata the project requires."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI001/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI002","name":"undocumented-error-response","shortDescription":{"text":"A FastAPI path operation declares every error status code it can produce."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI002/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI003","name":"router-wiring","shortDescription":{"text":"Every APIRouter with routes is included in an app, and no routers include each other in a cycle."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI003/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI005","name":"route-shadowing","shortDescription":{"text":"No FastAPI path operation is shadowed by an earlier one with the same method, so every route can be reached."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI005/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI006","name":"lifespan-events","shortDescription":{"text":"FastAPI apps use a lifespan context manager, not the deprecated on_event handlers, and never both, so every startup and shutdown handler runs."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI006/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI007","name":"yield-dependency-swallows","shortDescription":{"text":"A dependency with yield re-raises what its except clauses catch, so an error in the endpoint is not hidden from the server."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI007/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI008","name":"duplicate-operation-id","shortDescription":{"text":"No two path operations of one FastAPI app share an explicit operation_id, so generated clients get one method per operation."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI008/","defaultConfiguration":{"level":"error","enabled":false}},{"id":"FAPI009","name":"depends-called","shortDescription":{"text":"Depends and Security get the dependency function, not the result of calling it at import time."},"helpUri":"https://sircypkowskyy.github.io/inwards/rules/FAPI009/","defaultConfiguration":{"level":"error","enabled":false}}]}},"results":[{"ruleId":"INW001","level":"error","message":{"text":"Layer \\"domain\\" imports \\"shop.infrastructure.db\\" from outer layer \\"infrastructure\\". Allowed direction: domain <- infrastructure.\\nFix: Depend on an abstraction owned by \\"domain\\" instead of \\"shop.infrastructure.db\\".\\n1. Delete \`import shop.infrastructure.db\`. Do not move the import into a function or behind TYPE_CHECKING; Inwards checks those too.\\n2. Declare a typing.Protocol in \`shop.domain\` (for example \`shop.domain.ports\`) that describes only what this module needs from \`db\`.\\n3. Type this module against that Protocol and receive the implementation through a constructor or function parameter.\\n4. Make the class in \\"infrastructure\\" satisfy the Protocol, and wire it in the outermost layer (the composition root)."},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"shop/domain/order.py","uriBaseId":"%SRCROOT%"},"region":{"startLine":1,"startColumn":8,"endLine":1,"endColumn":30}}}],"properties":{"fix":{"summary":"Depend on an abstraction owned by \\"domain\\" instead of \\"shop.infrastructure.db\\".","steps":["Delete \`import shop.infrastructure.db\`. Do not move the import into a function or behind TYPE_CHECKING; Inwards checks those too.","Declare a typing.Protocol in \`shop.domain\` (for example \`shop.domain.ports\`) that describes only what this module needs from \`db\`.","Type this module against that Protocol and receive the implementation through a constructor or function parameter.","Make the class in \\"infrastructure\\" satisfy the Protocol, and wire it in the outermost layer (the composition root)."]}}}]}]}
"
,
}
`;

