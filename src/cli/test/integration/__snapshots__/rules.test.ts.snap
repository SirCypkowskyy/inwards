// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`rules without a config lists every rule at its default 1`] = `
{
  "code": 0,
  "stderr": "",
  "stdout": 
"No pyproject.toml with [tool.inwards] found: every rule at its default.

CODE     NAME                         STATE  SEVERITY  SOURCE
INW000   unsupported-encoding         on     error     always on
INW001   layer-dependency             on     error     default
INW002   context-independence         on     error     default
INW003   public-api-only              on     error     default
INW004   import-cycles                on     error     default
INW005   pure-domain                  on     error     default
INW006   unassigned-module            on     error     default
INW007   package-shape                on     error     default
INW008   missing-member               on     error     default
INW009   suppression-comment          on     error     default
INW010   unknown-first-party          on     error     default
INW011   dynamic-import               on     error     default
INW012   thin-endpoint                off    warning   opt-in, off by default
INW013   async-blocking               off    error     opt-in, off by default
INW014   ports-abstract               off    error     opt-in, off by default
INW015   construct-only-in            off    error     opt-in, off by default
INW016   orm-naming                   off    error     opt-in, off by default
INW017   diagram-unknown-name         off    warning   opt-in, off by default
FAPI001  endpoint-metadata            off    error     opt-in, off by default
FAPI002  undocumented-error-response  off    error     opt-in, off by default
FAPI003  router-wiring                off    error     opt-in, off by default
FAPI005  route-shadowing              off    error     opt-in, off by default
FAPI006  lifespan-events              off    error     opt-in, off by default
FAPI007  yield-dependency-swallows    off    error     opt-in, off by default
FAPI008  duplicate-operation-id       off    error     opt-in, off by default
FAPI009  depends-called               off    error     opt-in, off by default
"
,
}
`;

