exports[`rules with a --config that isn't a file is a usage error 1`] = `
{
  "code": 2,
  "stderr": 
"--config nope.toml: no such file.
"
,
  "stdout": "",
}
`;

exports[`rule "INW099" is a usage error, exit 2 1`] = `
{
  "code": 2,
  "stderr": 
"inwards rule: no rule "INW099". Did you mean INW009 (suppression-comment)? Run inwards rules for the list.
"
,
  "stdout": "",
}
`;

exports[`rule "layer-dependecy" is a usage error, exit 2 1`] = `
{
  "code": 2,
  "stderr": 
"inwards rule: no rule "layer-dependecy". Did you mean INW001 (layer-dependency)? Run inwards rules for the list.
"
,
  "stdout": "",
}
`;

exports[`rule "nothing-like-it" is a usage error, exit 2 1`] = `
{
  "code": 2,
