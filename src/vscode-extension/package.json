{
  "name": "inwards-vscode",
  "displayName": "Inwards",
  "description": "Architecture rules for Python, live in the editor. Same engine as `inwards check`.",
  "version": "0.0.1",
  "private": true,
  "publisher": "inwards",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:pyproject.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Inwards",
      "properties": {
        "inwards.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run Inwards architecture checks on Python files."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "build": "bun build src/extension.ts src/server.ts --outdir dist --target node --format cjs --external vscode && bun run scripts/copy-wasm.ts",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "@inwards/core": "workspace:*",
    "vscode-languageclient": "^10.1.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15",
    "tree-sitter-python": "0.25.0",
    "web-tree-sitter": "0.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "4.0.0"
  },
  "license": "MIT"
}
